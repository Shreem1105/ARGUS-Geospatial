POSTGRES_DB=argus
POSTGRES_USER=argus
POSTGRES_PASSWORD=argus_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=55432

DATABASE_URL=postgresql+psycopg://argus:argus_dev_password@localhost:55432/argus
ARGUS_DATA_DIR=data

# Auth / security
ARGUS_AUTH_ENABLED=true
ARGUS_JWT_SECRET=replace_with_local_dev_secret_min_32_chars
ARGUS_ACCESS_TOKEN_MINUTES=15
ARGUS_REFRESH_TOKEN_DAYS=14
ARGUS_COOKIE_SECURE=false
ARGUS_COOKIE_SAMESITE=lax
ARGUS_ACCESS_COOKIE_NAME=argus_access_token
ARGUS_REFRESH_COOKIE_NAME=argus_refresh_token
ARGUS_CSRF_COOKIE_NAME=argus_csrf_token
ARGUS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Quotas
ARGUS_QUOTA_MAX_MONITORS=10
ARGUS_QUOTA_MAX_ACTIVE_MONITORS=10
ARGUS_QUOTA_MAX_AOI_AREA_KM2=2000
ARGUS_QUOTA_MAX_MANUAL_RUNS_PER_DAY=20
ARGUS_QUOTA_MAX_OBSERVATION_SEARCHES_PER_DAY=60
ARGUS_QUOTA_MAX_SEMANTIC_RUNS_PER_DAY=30
ARGUS_QUOTA_MAX_CONCURRENT_JOBS=3

# Request rate limits
ARGUS_RATE_LIMIT_LOGIN_PER_MINUTE=20
ARGUS_RATE_LIMIT_REGISTER_PER_HOUR=30
ARGUS_RATE_LIMIT_REFRESH_PER_MINUTE=60
ARGUS_RATE_LIMIT_OBSERVATION_SEARCH_PER_MINUTE=30
ARGUS_RATE_LIMIT_MANUAL_RUN_PER_MINUTE=20

# Email delivery
ARGUS_EMAIL_PROVIDER=none
ARGUS_EMAIL_FROM=no-reply@example.com
ARGUS_EMAIL_API_KEY=
ARGUS_EMAIL_RESEND_API_URL=https://api.resend.com

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
JOB_MAX_RETRIES=2
JOB_RETRY_BACKOFF_SECONDS=30
CELERY_TASK_TIME_LIMIT_SECONDS=3600
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=3300
MONITOR_SCHEDULE_SCAN_SECONDS=300
MIN_MONITOR_SCHEDULE_CADENCE_MINUTES=60
MONITOR_FIRST_RUN_LOOKBACK_DAYS=60
MONITOR_SUBSEQUENT_OVERLAP_DAYS=7
MONITOR_RUN_SEARCH_LIMIT=80
MONITOR_RUN_MAX_CLOUD_COVER=40

POSTGRES_HOST_PORT=55432
